# CONVOX backend — environment template
# 1) Copy this file to `.env`  (git-ignored; never commit real keys)
# 2) Paste YOUR keys into the blanks below
# 3) Save and restart uvicorn. `settings` reloads .env at import time.

# --- Anthropic (conversation + evaluation models) ---
ANTHROPIC_API_KEY=

# --- Groq (Whisper speech-to-text) ---
GROQ_API_KEY=

# --- OpenAI (text-to-speech for the AI voice) ---
OPENAI_API_KEY=

# --- Optional overrides (defaults shown) ---
# CONVERSATION_MODEL=claude-sonnet-5
# EVALUATION_MODEL=claude-sonnet-5
# STT_MODEL=whisper-large-v3
# TTS_MODEL=tts-1
# TTS_VOICE=alloy
# MAX_TURNS=14
# ENABLE_EVENTS=true
# DATABASE_URL=sqlite+aiosqlite:///./convox.db